# Hackerbot2 LLM configuration - copy to /opt/hackerbot2/config/hb2.env
# (referenced by hackerbot2.service via EnvironmentFile)
# All variables are optional; defaults are shown.

# Provider: ollama, openai, vllm, sglang
#HB2_LLM_PROVIDER=ollama
#HB2_LLM_HOST=localhost
#HB2_LLM_PORT=11434
#HB2_LLM_MODEL=gemma3:1b

# OpenAI-compatible endpoints (OpenAI, LiteLLM, llama.cpp, Together.ai...)
#HB2_OPENAI_API_KEY=no-key-needed
#HB2_OPENAI_BASE_URL=http://localhost:4000

# vLLM / SGLang
#HB2_VLLM_HOST=localhost
#HB2_VLLM_PORT=8000
#HB2_SGLANG_HOST=localhost
#HB2_SGLANG_PORT=30000

# Global embedding model (can be overridden per-bot via <embedding_model> in the bot XML)
#HB2_EMBEDDING_MODEL=nomic-embed-text
